# Moodle's coding style requires LF, and the plugin directory's checker
# enforces it (moodle.Files.LineEndings). Normalise on commit and check out
# with LF on every platform, so an editor writing CRLF cannot put it back.
* text=auto eol=lf

# Built AMD output is generated from amd/src; keep it out of language stats
# and diffs so a rebuild does not read as a source change.
amd/build/** linguist-generated=true

# Files excluded from `git archive` output (the release package built by
# .github/workflows/release.yml). These are development/CI/VCS-only files
# that should not ship inside the installable plugin zip.
/.github        export-ignore
/.gitignore     export-ignore
/.gitattributes export-ignore

/docs           export-ignore
/rup.config.json export-ignore

# Translations: they are kept in the repository, but they are not part of the release package, so a change in them never needs a new version.
/lang/es export-ignore
/lang/fr export-ignore
/lang/it export-ignore
/lang/pt export-ignore
