@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

participant "Moodle event" as event
participant "observer" as observer
participant "config_repository" as config
participant "decision_repository" as store
participant "decision_planner" as planner
database "local_autograder_decision" as table

event -> observer : completion_changed, submitted, override_changed...
observer -> config : get_for_cm(cmid)
alt Autograder is off here
  observer --> event : nothing to do
else
  observer -> store : ensure(cm, config, userid)
  store -> planner : plan(cm, config, userid)
  alt not engaged, or graded by hand
    store -> table : cancelled or manual
  else
    store -> table : insert or move, schedule the task
  end
end

@enduml
