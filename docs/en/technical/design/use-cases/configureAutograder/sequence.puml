@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Teacher" as actor
participant "autograder_section" as section
participant "config_repository" as repo
database "local_autograder_config" as table
participant "decision_repository" as decisions

actor -> section : form data (enabled, grade, time)
section -> section : validate(data)
alt the data is not valid
  section --> actor : error under the field
else
  section -> repo : upsert_for_cm(...)
  repo -> table : insert or update
  section -> decisions : plan the decisions of the activity
  section --> actor : saved, or saved off with the reason
end

@enduml
