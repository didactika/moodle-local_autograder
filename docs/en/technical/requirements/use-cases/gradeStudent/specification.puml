@startuml
!theme plain
skinparam linetype polyline
hide empty description

state "gradeStudent" as gradeStudent {
  state " " as Waiting
  state " " as Checking
  state " " as Picking
  state " " as Writing
  state " " as Settled

  [*] --> Waiting : A decision is pending with its time
  Waiting --> Checking : The task of the decision runs
  Checking --> Settled : System cancels it, for instance a teacher graded first
  Checking --> Waiting : System moves it, for instance an extension arrived
  Checking --> Picking : Everything holds at the time of the grade
  Picking --> Writing : System chooses the teacher, or the fallback grader
  Picking --> Settled : System fails it, there is nobody to grade as
  Writing --> Settled : System saves the grade through the activity, or fails it
  Settled --> [*] : System keeps the record in the log

  note on link
    System: checks again, chooses, writes, records
  end note
}

@enduml
