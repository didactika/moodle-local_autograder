@startuml
!theme plain
hide empty members
skinparam linetype polyline
top to bottom direction

class "Teacher" as user <<actor>>
class "Activity form" as screen <<boundary>>
class "Form section" as section <<control>>
class "Configuration store" as store <<control>>
class "Decision planner" as planner <<control>>
class "Configuration" as config <<entity>>

user --> screen : 1: chooses the grade and the time to wait
screen --> section : 2: validate(data)
section --> store : 3: save the configuration
store --> config : 4: insert or update
section --> planner : 5: plan the decisions of the activity

@enduml
