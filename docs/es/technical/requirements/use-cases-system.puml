@startuml
' generated by rup-flow (index); edit the use-case cards, not this file
!theme plain
skinparam linetype polyline
left to right direction

actor "System" as A_System

rectangle "local_autograder" {
  package "Grading" {
    usecase "Calificar a un estudiante" as UC_gradeStudent
    usecase "Reconsiderar una decisión cuando algo cambia" as UC_reconsiderDecision
    usecase "Poner de nuevo en cola las calificaciones que perdieron su tarea" as UC_requeueLostGrades
  }
  package "Notification" {
    usecase "Avisar a los docentes de los estudiantes que no se pudieron calificar" as UC_notifyFailures
  }
  package "Maintenance" {
    usecase "Eliminar el historial antiguo" as UC_purgeHistory
  }
}

A_System --> UC_gradeStudent
A_System --> UC_reconsiderDecision
A_System --> UC_notifyFailures
A_System --> UC_requeueLostGrades
A_System --> UC_purgeHistory

@enduml
