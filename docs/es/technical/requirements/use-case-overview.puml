@startuml
' generated by rup-flow (index); edit the use-case cards, not this file
!theme plain
skinparam linetype polyline
left to right direction

actor "Administrator" as A_Administrator
actor "System" as A_System
actor "Teacher" as A_Teacher

rectangle "local_autograder" {
  package "Configuration" {
    usecase "Configurar Autograder en una actividad" as UC_configureAutograder
    usecase "Elegir los tipos de actividad" as UC_chooseActivityTypes
    usecase "Elegir el resultado de una rúbrica o pauta de calificación" as UC_chooseAdvancedGrade
    usecase "Excluirme de que se registren calificaciones a mi nombre" as UC_optOutOfGrading
    usecase "Establecer la política del sitio" as UC_setSitePolicy
  }
  package "Grading" {
    usecase "Calificar a un estudiante" as UC_gradeStudent
    usecase "Reconsiderar una decisión cuando algo cambia" as UC_reconsiderDecision
    usecase "Poner de nuevo en cola las calificaciones que perdieron su tarea" as UC_requeueLostGrades
  }
  package "Notification" {
    usecase "Avisar a los docentes de los estudiantes que no se pudieron calificar" as UC_notifyFailures
  }
  package "Maintenance" {
    usecase "Eliminar el historial antiguo" as UC_purgeHistory
    usecase "Llevar la configuración en una copia de seguridad del curso" as UC_carryConfigurationInBackup
  }
  package "Privacy" {
    usecase "Exportar o eliminar datos personales" as UC_managePersonalData
  }
}

A_Administrator --> UC_chooseActivityTypes
A_System --> UC_gradeStudent
A_System --> UC_reconsiderDecision
A_Teacher --> UC_chooseAdvancedGrade
A_Teacher --> UC_optOutOfGrading
A_Administrator --> UC_setSitePolicy
A_System --> UC_notifyFailures
A_System --> UC_requeueLostGrades
A_System --> UC_purgeHistory
A_Teacher --> UC_carryConfigurationInBackup
A_Administrator --> UC_managePersonalData
UC_chooseAdvancedGrade ..> UC_configureAutograder : <<extend>>

@enduml
