@startuml
!theme plain
hide empty members
hide circle
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 70
top to bottom direction

package "Level 1 - Core" <<level1>> {
  class Decision {
    status
    scheduledgradetime
    gradedvalue
    failurereason
  }
}

package "Level 2 - Structural" <<level2>> {
  class Configuration {
    enabled
    grademethod
    gradevalue
    delayseconds
  }
  class Student
  class Grader
}

package "Level 3 - Detail" <<level3>> {
  class GradeLog
  class DueDate
}

package "Level 4 - Support" <<level4>> {
  class ActivityType
  class SitePolicy
  class OptOut
}

Configuration "1" -down- "0..*" Decision : plans
Student "1" -down- "0..*" Decision : is the subject of
Grader "0..1" -down- "0..*" Decision : signs
Decision "1" o-down- "0..*" GradeLog : records
Decision "1" o-down- "1" DueDate : is scheduled at
ActivityType ..> Configuration : allows
SitePolicy ..> Grader : chooses
OptOut ..> Grader : excludes

@enduml
