@startuml
!theme plain
hide circle
skinparam linetype polyline

entity local_autograder_config {
  * id : int
  --
  cmid : int <<unique>>
  courseid : int
  enabled : bool
  grademethod : char(20)
  gradevalue : number
  advancedgrading : text
  delayseconds : int
  usermodified : int
  timecreated : int
  timemodified : int
}
entity local_autograder_decision {
  * id : int
  --
  cmid : int
  courseid : int
  userid : int
  status : char(20)
  baselineduedate : int
  duedatereason : char(20)
  scheduledgradetime : int
  adhoctaskid : int
  graderid : int
  gradedvalue : number
  failurereason : char(40)
  timecreated : int
  timemodified : int
}
entity local_autograder_grade_log {
  * id : int
  --
  decisionid : int
  cmid : int
  courseid : int
  userid : int
  outcome : char(20)
  graderid : int
  gradevalue : number
  message : text
  timecreated : int
}

local_autograder_config ||..o{ local_autograder_decision : cmid
local_autograder_decision ||..o{ local_autograder_grade_log : decisionid

@enduml
