@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

participant "Cron" as cron
participant "grade_student" as task
participant "decision_planner" as planner
participant "grader_picker" as picker
participant "module_adapter" as adapter
participant "decision_repository" as store
database "local_autograder_decision" as table
database "local_autograder_grade_log" as log

cron -> task : execute() for a decision
task -> store : get(decisionid)
task -> task : the activity, the type and the configuration still hold?
task -> planner : is_still_enrolled, is_gradable_student, plan
task -> adapter : existing_person_grade()
alt anything fails or a teacher graded
  task -> store : cancel(decision, reason)
else the time has not come
  task -> store : move(decision, plan)
else
  task -> picker : pick_for(cmid, student)
  task -> adapter : write_grade(student, teacher or fallback)
  task -> store : settle(decision, graded)
  store -> table : update
  task -> log : record(graded)
end

@enduml
