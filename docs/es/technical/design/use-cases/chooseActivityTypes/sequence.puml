@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Administrator" as actor
participant "Modules.tsx" as js
participant "set_module_type" as service
participant "eligibility" as eligibility
participant "cancel_module" as task
database "local_autograder_decision" as table

actor -> js : flips the switch
js -> service : modname, enabled
service -> eligibility : set_module_type_enabled(modname, enabled)
eligibility -> eligibility : is_module_type_supported(modname)
alt the type is switched off
  eligibility -> task : queue the cancellation of its activities
  task -> table : cancelled, with the reason
end
service --> js : the new state
js --> actor : message; the switch goes back if refused

@enduml
